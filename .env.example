# Sentra — environment configuration
# Copy to .env and fill in. Never commit .env to git.

# ── Required (cloud model tier) ──────────────────────────────
# OpenRouter API key — powers the cheap/std/code tiers.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# ── Router auth ──────────────────────────────────────────────
# Bearer key Open WebUI uses to talk to the router (any long random string).
# Generate with: openssl rand -hex 24
ROUTER_API_KEY=change-me-generate-a-random-key

# ── Open WebUI admin ─────────────────────────────────────────
# First-run admin account (created on first boot if signup is disabled).
OWUI_ADMIN_EMAIL=admin@localhost.local
OWUI_ADMIN_PASSWORD=change-me

# ── Optional: local LLM tier (llama.cpp) ──────────────────────
# Point the router's "local" tier at your own llama.cpp server.
# Leave unset to run cloud-only. See docs/local-llm.md.
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
